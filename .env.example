# OpenAI Configuration (for summarization only)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: override the text model used for optimization / summary / translation
# For Google Gemini OpenAI-compatible endpoint, set something like:
# OPENAI_MODEL=gemini-2.5-flash
# or, if your key supports it:
# OPENAI_MODEL=gemini-3.1-flash-lite-preview
#
# If omitted, the app will choose a sensible default based on OPENAI_BASE_URL.

# Local Whisper Configuration
USE_LOCAL_WHISPER=true
WHISPER_MODEL=base

# Server Configuration
PORT=3000

# Optional: Legacy audio processing limits (not used in local mode)
MAX_SEGMENT_SIZE_MB=25
SEGMENT_DURATION_SECONDS=600
